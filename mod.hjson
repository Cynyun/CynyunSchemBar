#the mod name as displayed in-game
displayName: "Cynyun SchemBar"

#the internal name of your mod
name: "cynyun-schembar"

#your name
author: "Cynyun"

#the fully qualified main class of the mod
main: "Main"

#the mod description as seen in the mod dialog
description: "Mindustry 悬浮窗 Mod：把蓝图按栏目、序列、蓝图按钮三层组织并常驻游戏界面，一键调用，不用每次打开原版蓝图对话框翻列表。"

#the mod version
version: 1.0.0

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true

#this is a multiplayer-compatible mod
hidden: true